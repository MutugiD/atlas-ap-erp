{
  "name": "atlas-ap-erp",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "scripts": {
    "dev:api": "bun --filter @atlas/api dev",
    "dev:web": "bun --filter @atlas/web dev",
    "dev:support": "bun --filter @atlas/support-agent dev",
    "test": "bun test",
    "lint": "eslint .",
    "audit": "bun audit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "infra:synth": "bun --filter @atlas/infra synth",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "license:audit": "bun run scripts/license-audit.ts",
    "test:live-support": "bun run scripts/run-live-support-tests.ts",
    "test:live-api": "bun run scripts/run-live-api-tests.ts",
    "release:check": "bun run scripts/support-release-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1095.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/client-secrets-manager": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "aws-cdk-lib": "^2.262.1",
    "bullmq": "^5.81.2",
    "constructs": "^10.7.1",
    "cockatiel": "^3.2.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "hono": "^4.12.32",
    "ioredis": "^5.11.1",
    "next": "^15.5.22",
    "prom-client": "^15.1.3",
    "jose": "^5.10.0",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "aws-cdk": "^2.1133.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "postcss": ">=8.5.17",
    "sharp": ">=0.35.0",
    "fast-uri": ">=4.1.1",
    "find-my-way": ">=9.6.1",
    "brace-expansion": ">=5.0.8",
    "esbuild": ">=0.25.0"
  }
}
